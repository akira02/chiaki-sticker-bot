# Required
BOT_TOKEN=123456789:replace-with-your-bot-token

# Use a public HTTPS URL when receiving Telegram webhooks. Leave WEBHOOK_URL
# unset to use long polling instead.
WEBHOOK_URL=https://bot.example.com/webhook
WEBHOOK_SECRET=replace-with-a-random-secret

# Optional
# ADMIN_UID=123456789
# WEBAPP_URL=https://bot.example.com/webapp
# LOG_LEVEL=info

# Resource tuning. These defaults are safe for a small host; raise the limits
# and concurrency only when the host has sufficient RAM and CPU.
GOMEMLIMIT=128MiB
MSB_IMPORT_CONCURRENCY=1
MSB_FFMPEG_CONCURRENCY=1
MSB_IM_MEMORY_LIMIT=64MiB
MSB_IM_MAP_LIMIT=128MiB
MSB_IM_OOM_MEMORY_LIMIT=32MiB
MSB_IM_OOM_MAP_LIMIT=64MiB

# Optional MySQL-compatible database. Leave all three unset to disable it.
# DB_ADDR=db.example.com:3306
# DB_USER=moe_sticker_bot
# DB_PASS=replace-with-a-password
